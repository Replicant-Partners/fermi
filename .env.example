# Fermi Active Dreaming Memory - Environment Variables

# Database (Vercel Postgres or other PostgreSQL)
DATABASE_URL="postgres://user:password@host:5432/database"

# API Keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Git Configuration
REPO_PATH="/home/ilabra/fermi"
GIT_USER_NAME="Fermi Bot"
GIT_USER_EMAIL="bot@fermi.dev"
GITHUB_TOKEN=""  # Optional: for automated pushes

# Consolidation Worker
WORKER_ID="worker-1"
CONSOLIDATION_TIME="02:00"  # Daily at 2am
AUTO_PUSH="false"  # Set to "true" to auto-push to GitHub

# Embedding Configuration (for future AKP compatibility)
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_DIMENSION="1024"
EMBEDDING_PROVIDER="openai"  # or "anthropic"
OPENAI_API_KEY=""  # If using OpenAI embeddings

# Optional LLM providers
# OpenRouter (free-tier fallback for community agents)
OPENROUTER_API_KEY=""

# Ollama — local or operator-hosted OpenAI-compatible inference.
# Set OLLAMA_BASE_URL to activate (no API key required).
# A1 operator-hosted:  OLLAMA_BASE_URL=http://ollama:11434/v1
# A2 BYO endpoint:     OLLAMA_BASE_URL=https://ollama.your-domain.com/v1
# Development default: set OLLAMA_ENABLE=true to use http://localhost:11434/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_ENABLE=true  # alternative: use localhost default without explicit URL

# Railway deployment
# Raise the Railway proxy request timeout to 60s so creature agent calls
# (enemy_sensor, genome_profiler, prey_locator) have room to complete their
# GBIF tool loop. Without this Railway kills the connection at ~30s default.
# Set this in the Railway dashboard: Settings → Variables → RAILWAY_TIMEOUT=60
RAILWAY_TIMEOUT=60

# kask-app-wild: foraging intelligence data sources
# OpenWeatherMap API key — free tier at https://openweathermap.org/api
# Required for condition_forecaster and forage_scout microclimate data
OPENWEATHER_API_KEY=""

# MycoBank API key — bearer token from https://www.mycobank.org
# Optional: mycobank_lookup falls back to GBIF without this key
MYCOBANK_API_KEY=""

# ─── Remote MCP servers (outbound) ────────────────────────────────
# Agents can consume tools from remote MCP servers declared in their
# card's `capabilities.mcp_servers` block. See
# docs/architecture/REMOTE_MCP_CLIENT.md
#
# Credentials resolve in this order (mcp_client.rs::resolve_credential):
#   1. `auth.secret_key` in the agent owner's encrypted secret store
#      — PREFERRED. Per-agent, rotatable, never in the repo. Managed
#        from the agent's MCP panel in the ABW UI.
#   2. `auth.env` — a process env var here. Platform-funded fallback,
#      shared by every agent that names it, and requires a restart to
#      rotate. Use only for platform-owned integrations.
#
# There is no entry to add by default: declaring a server is a card
# edit, and its credential normally lives in the secret store rather
# than this file. Add a variable here only when you deliberately want a
# platform-funded, process-wide credential, e.g.:
#
#   SOME_SERVICE_MCP_KEY=""

# ─── Transactional email (Resend) ─────────────────────────────────
# Used for team / forecast / portfolio invite emails. When RESEND_API_KEY
# is unset the server silently falls back to the copy-link modal — nothing
# else breaks, but recipients get no email. See docs/fermi/guides/email-setup.md.
#
# 1. Sign up at https://resend.com (free tier: 3k emails/mo, 100/day).
# 2. Verify a sending domain (e.g. agent-bestiary.world). Add the DKIM/SPF
#    records they show you at your DNS host (Name.com).
# 3. Create an API key in the Resend dashboard → API Keys.
# 4. Set the three vars below in Railway (api-server) AND Vercel (frontend).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Fermi <no-reply@agent-bestiary.world>"
APP_BASE_URL="https://agent-bestiary.world"

# Development
RUST_LOG="info"

# ─── Rate limits (requests per minute) ────────────────────────────
# RATE_LIMIT_PUBLIC / RATE_LIMIT_AUTH are per-IP on the public router.
#
# RATE_LIMIT_LLM is per-user and applies ONLY to the endpoints that
# dispatch a model — see LLM_SPEND_ROUTES in src/api_server.rs. Everything
# else on the protected router passes straight through.
#
# ⚠ This one was inert until 2026-08-15: the middleware existed, the
# limiter was constructed from this variable on every boot, and it was
# never layered onto a router (`#[allow(dead_code)]`). So the endpoints
# that spend real money were the only ones with no rate limit, while the
# public read-only routes had one. Wiring it up means the default below
# now actually binds — raise it if legitimate traffic hits 429s, but raise
# it deliberately rather than to make an alert go away.
RATE_LIMIT_PUBLIC="300"
RATE_LIMIT_AUTH="300"
RATE_LIMIT_LLM="10"
