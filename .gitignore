__pycache__/
*.pyc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/

# Build outputs
dist/
build/

# Test coverage
coverage/
*.profraw
*.profdata

# Temporary files
*.tmp
*.temp
.cache/

# Local environment
.env
.env.local
.env.*.local

# Documentation builds
docs/_build/
site/

# Flutter web build (served from rabble-web/, copied by Dockerfile)
static/rabble/

# Fermi-specific
examples/*.results.json
*.fpl.results

# Tree-sitter build artifacts
tree-sitter-fpl/src/
tree-sitter-fpl/binding.gyp
tree-sitter-fpl/bindings/
tree-sitter-fpl/build/

# Vercel
.vercel
Screenshot_20260213-024023.png
.env*.local
nohup.out

# Generated docs (PDFs produced from .md source by external tooling — pandoc,
# the "Export as PDF" workflow, etc.). The markdown is the source of truth;
# the PDFs are build artifacts that drift out of sync if committed.
docs/**/*.pdf

# abw CLI per-user credentials (in case anyone runs the CLI from inside
# the checkout). The real path is ~/.abw/credentials but this catches
# stray local-override files.
.abw/credentials
crates/abw-cli/.env

# Integrity audit transcripts (may contain sample row ids)
integrity-audit-*.txt

# local commit-message drafts
.gitmsg-*
