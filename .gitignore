nohup.out

# Generated docs (PDFs produced from .md source by external tooling — pandoc,
# the "Export as PDF" workflow, etc.). The markdown is the source of truth;
# the PDFs are build artifacts that drift out of sync if committed.
docs/**/*.pdf

# abw CLI per-user credentials (in case anyone runs the CLI from inside
# the checkout). The real path is ~/.abw/credentials but this catches
# stray local-override files.
.abw/credentials
crates/abw-cli/.env

# Integrity audit transcripts (may contain sample row ids)
integrity-audit-*.txt

# local commit-message drafts
.gitmsg-*

# Operator-initiated wiki exports (Composer → Export wiki). These are
# artifacts of using the app, not source.
#
# Until v0.12.1 the console also wrote .fpl/.state.json here on every
# Ctrl+S and then ran `git add` + `git commit` on whatever repo the CWD
# belonged to — which, run from a checkout, meant this one. That is how
# 806 "v3: 42.1% (+2pp) — Will …" commits and 205 tracked files under
# forecasts/ got here. The write is gone; this keeps the remaining
# deliberate exports from drifting back in.
#
# The already-tracked files under forecasts/ are left alone — they are
# real historical forecasts and deleting them is a separate decision.
# .gitignore does not affect tracked paths, so this only governs new ones.
forecasts/*.fpl
forecasts/*.state.json
forecasts/*.evidence.md

# UI review screenshots — local visual-diff artefacts, not source.
.ui-review/

# Scratch commit-message files.
#
# One of these (.git-msg-3.txt) reached origin, and how it got there is worth
# knowing: two agents were committing in this working tree at once, one ran
# `git add` between the other's `git add` and its `git commit`, and the commit
# took the whole index rather than the paths that were staged for it.
#
# Ignoring the pattern removes the sharp edge. The durable fix is to commit
# with `git commit --only <paths>`, which commits the named paths regardless of
# what else the index has picked up.
.git-msg-*.txt

.gitmsg-ux

# Runtime workspace git repositories, created by WorkspaceGitManager.
# State, not source: 1.2M and growing with every workspace.
repos/

# A whole second copy of the repo (5.2GB) left by a release check. Untracked
# and unignored, it was walked by tests/provenance_floor_coverage.rs and made it
# report findings in files that are not this build's source.
.release-verify/
