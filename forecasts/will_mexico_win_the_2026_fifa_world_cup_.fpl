question "Will Mexico win the 2026 FIFA World Cup?"

driver socio_capital continuous {
    distribution: triangular(0, 0, 0)
    rationale: "Macro capacity for footballing investment: GDP, population, HDI."
}

driver institutional_capacity continuous {
    distribution: triangular(0.75, 1, 1.3)
    rationale: "Federation strength, league development, player pipeline depth."
}

driver dynamic_performance continuous {
    learnable: true
    rationale: "Recent form and Elo trajectory — refits as match outcomes accumulate."
}

driver squad_quality continuous {
    distribution: triangular(0.7, 1, 1.35)
    learnable: true
    rationale: "Top-flight league penetration + market-value concentration; updates as injuries / form are reported."
}

driver tactical_efficiency continuous {
    distribution: triangular(0.8, 1, 1.25)
    learnable: true
    rationale: "Shot conversion, defensive duels, pressing intensity — observable per-match."
}

driver fixture_context continuous {
    distribution: triangular(0.9, 1, 1.1)
    rationale: "Per-fixture context: venue, climate, rest, altitude. Volatile, refreshed per match."
}

model: (((((socio_capital * institutional_capacity) * dynamic_performance) * squad_quality) * tactical_efficiency) * fixture_context)

simulate 10000 iterations