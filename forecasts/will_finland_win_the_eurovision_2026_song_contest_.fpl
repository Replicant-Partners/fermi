evidence market_research_0 {
    source: "Agent: market_research (Claude API)"
    summary: "The research indicates that the candidate song has strong performance metrics compared to the top 5 songs in the genre, with a higher Spotify popularity score, comparable streaming numbers, and slightly better critical reception. However, it lags behind the top 5 in terms of playlist features and chart performance duration."
    relevance: 0.85p
    date: 2026-03-05
}

evidence manual_song_quality_percentile_2 {
    source: "https://youtu.be/9bfwNIYb96Q?si=7leL6G0cPhYE1MLH"
    summary: "candidate song"
    relevance: 0.7p
    date: 2026-03-05
}

evidence sentiment_analyzer_0 {
    source: "Agent: sentiment_analyzer (Claude API)"
    summary: "The analysis of Eurovision voting patterns from 2015-2024 indicates that the Nordic voting bloc (Finland, Sweden, Norway, Denmark, Iceland) has maintained strong cohesion, with an average of 75% of points exchanged between these countries in the finals. Periods of heightened cultural cooperation and positive sentiment toward Eurovision correlated with the strongest bloc voting, while disruptions like the COVID-19 pandemic led to temporary declines. Overall, the data suggests the Nordic bloc is likely to remain a significant force in future Eurovision contests, barring any major political or cultural shifts in the region."
    relevance: 0.85p
    date: 2026-03-05
}

model: song_quality_percentile * nordic_voting_bloc_strength * public_vote_advantage * (if semi_final_qualification then 1.3 else 1.0) * competitive_field_strength

simulate 10000 iterations