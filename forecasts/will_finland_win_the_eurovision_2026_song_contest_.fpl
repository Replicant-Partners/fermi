question "Will finland win the eurovision 2026 song contest?"

driver song_quality_percentile continuous {
    distribution: triangular(30, 50, 85)
    unit: "percentile_rank"
    rationale: "Finland's historical Eurovision performance shows high variance. Median finish ~15th place out of ~26 finalists. Strong entries (2006 winner, 2023 2nd place Käärijä) demonstrate capability for top-tier songs, but consistency is moderate."
}

driver voting_bloc_advantage continuous {
    distribution: triangular(-2, 1, 4)
    unit: "net_points_advantage"
    rationale: "Finland receives moderate Nordic voting support but lacks strong diaspora voting blocs compared to countries like Greece, Cyprus, or former Yugoslav states. Post-2023 rule changes reduced jury power (50/50 split maintained), slightly favoring public vote where Finland can perform well with novelty acts."
}

driver big_5_competition_strength continuous {
    distribution: triangular(0.2, 0.4, 0.9)
    unit: "probability_big5_wins"
    rationale: "Big 5 countries (UK, France, Germany, Italy, Spain) auto-qualify and have won ~25% of contests since 2000. Strong Big 5 entries reduce Finland's winning probability by concentrating votes."
}

driver recent_momentum_effect binary {
    probability: 0.5p
    impact_multiplier: 1.3
    rationale: "Finland's 2023 second-place finish with Käärijä (public vote winner) created significant momentum and international attention. Countries often leverage recent success (see Ukraine 2016→2017 interest, Italy 2021→2022). This increases selection quality and public interest for 2026."
}

driver years_since_last_win continuous {
    distribution: triangular(18, 20, 22)
    unit: "years"
    rationale: "Finland last won in 2006 (20 years before 2026). 'Sympathy vote' or 'overdue narrative' has weak empirical support but may marginally influence close contests. More importantly, long gaps suggest structural challenges in song selection or performance."
}

