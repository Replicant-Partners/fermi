evidence sentiment_analyzer_0 {
    source: "Agent: sentiment_analyzer (Claude API)"
    summary: "Conducting a similarity search on the structural elements of a song and comparing it to the structure of other popular, successful songs can provide valuable insights into the song's potential for mainstream popularity and commercial performance. While song structure is an important factor, other elements like lyrical content, artist brand, and production quality also significantly influence a song's popularity. Analyzing a comprehensive dataset of song structures and their corresponding popularity metrics can help develop predictive models to forecast a song's success."
    relevance: 0.8p
    date: 2026-03-04
}

evidence market_research_0 {
    source: "Agent: market_research (Claude API)"
    summary: "The analysis of the Big 5 countries' Eurovision performance trends, 2026 national selection processes, early betting odds, and social media sentiment suggests that Italy and Spain are currently the strongest contenders among the group, while the UK, France, and Germany have struggled to maintain their historical competitiveness in the contest."
    relevance: 0.85p
    date: 2026-03-04
}

model: song_quality_percentile * voting_bloc_advantage * big_5_competition_strength * (if recent_momentum_effect then 1.3 else 1.0) * years_since_last_win

simulate 10000 iterations