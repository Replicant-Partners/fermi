question "will the lakers win their next game?"

driver home_court_advantage continuous {
    distribution: triangular(0.85, 1, 1.16)
    unit: "multiplier"
    rationale: "If home, +16% boost typical. If away, -15% penalty typical. Uncertainty reflects unknown venue."
}

driver recent_form continuous {
    distribution: triangular(0.65, 0.8, 1.25)
    unit: "multiplier"
    rationale: "Lakers' recent performance trends affect win probability. Teams on winning streaks gain momentum; losing streaks reduce chances."
}

driver opponent_strength continuous {
    distribution: triangular(0.7, 1.1, 1.35)
    unit: "multiplier"
    rationale: "Opponent quality varies significantly. Playing top teams (Celtics, Nuggets) reduces chances; weak opponents increase them."
}

driver injury_status continuous {
    distribution: triangular(0.4, 1.2, 1.4)
    unit: "multiplier"
    rationale: "Availability of LeBron James, Luka Doncic, and other starters critically impacts win probability. Opponent injuries also matter."
}

driver rest_days continuous {
    distribution: triangular(0.9, 1, 1.6)
    unit: "multiplier"
    rationale: "Back-to-back games reduce win probability ~10%. Well-rested teams perform better, especially for aging rosters."
}

