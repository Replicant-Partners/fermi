question "will poland win the eruvision contest in 2026?"

driver song_quality_percentile continuous {
    distribution: triangular(30, 50, 85)
    unit: "percentile_rank"
    rationale: "Poland's best Eurovision result was 2nd place (Michał Szpak, 2016). Historical performance: median finish ~15th place (out of ~26 finalists). Song quality is highly variable year-to-year. Poland has qualified for finals 11/20 times (55% qualification rate vs ~50% baseline for semi-finalists)."
}

driver televoting_appeal_factor continuous {
    distribution: triangular(0.6, 1, 1.8)
    unit: "relative_to_average"
    rationale: "Poland receives moderate diaspora voting support (UK, Ireland, Scandinavia have Polish communities). However, lacks strong regional voting bloc compared to Balkans, Nordics, or ex-Soviet states. 2016 runner-up finish showed Poland CAN achieve high televoting when song resonates broadly."
}

driver jury_appeal_factor continuous {
    distribution: triangular(0.5, 0.9, 1.4)
    unit: "relative_to_average"
    rationale: "Poland historically underperforms with juries vs televoting. Juries favor vocal technique, staging sophistication, and contemporary production. Poland's entries often more traditional/rock-oriented, less aligned with jury preferences (pop, ballads with strong vocals)."
}

driver competitive_field_strength continuous {
    distribution: triangular(22, 26, 30)
    unit: "number_of_strong_competitors"
    rationale: "2026 will have ~40 countries competing, ~26 finalists. Typically 5-8 countries enter as genuine contenders (based on national selection quality, artist profile, production budget). Poland competes against perennial strong performers: Sweden, Italy, Ukraine, Netherlands, Australia, France."
}

