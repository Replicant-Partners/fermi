question "will italy win the eurovision song contest this year?"

driver song_quality__expert_ratings_ continuous {
    distribution: triangular(3, 6.5, 9)
    unit: "rating_out_of_10"
    rationale: "Eurovision outcomes correlate moderately with pre-contest expert ratings and betting odds. Italy's 2025 entry would need to score 8+ to be competitive for victory. Historical winners average 7.5-8.5 in pre-contest expert assessments."
}

driver betting_odds_rank continuous {
    distribution: triangular(1, 8, 20)
    unit: "rank_position"
    rationale: "Betting markets are the strongest predictor of Eurovision outcomes. Since 2010, the betting favorite wins ~40% of the time, and top-3 favorites win ~70% of the time. Italy's typical pre-contest ranking varies widely (1st in 2021, 10th+ in other years)."
}

driver sanremo_winner_effect binary {
    probability: 0.5p
    impact_multiplier: 1.3
    rationale: "Italy selects via Sanremo Festival. Sanremo winners have mixed Eurovision success: Måneskin (2021 winner) won Eurovision, but many Sanremo winners place mid-table. The selection process matters: internally-chosen songs sometimes outperform."
}

driver voting_bloc_advantage continuous {
    distribution: triangular(50, 120, 200)
    unit: "expected_points"
    rationale: "Italy receives moderate diaspora/cultural voting from neighboring countries (Malta, San Marino typically award high points) but lacks a strong voting bloc compared to Balkans or Nordics. Expected baseline: 100-150 points from geographic/cultural voting patterns."
}

driver big_5_automatic_final_advantage binary {
    probability: 0.5p
    impact_multiplier: 1.3
    rationale: "As a Big 5 country, Italy automatically qualifies for the final, avoiding semi-final momentum building but guaranteeing exposure. Big 5 countries win ~25% of contests (above their 20% representation), suggesting slight structural advantage."
}

evidence market_research_0 {
    source: "Agent: market_research (Claude API)"
    summary: "Based on Italy's past success in the Eurovision Song Contest, the positive reception of their 2023 entry, and their current status as a favorite among bookmakers, there is a reasonable probability that Italy could win the 2023 competition. However, the unpredictable nature of the contest means that other countries may also have a strong chance of winning, and the final result is difficult to forecast with high confidence."
    relevance: 0.75p
    date: 2026-03-03
}

evidence sentiment_analyzer_0 {
    source: "Agent: sentiment_analyzer (Claude API)"
    summary: "The research indicates that Italy has a favorable history in the Eurovision Song Contest and their 2023 entry is receiving positive reviews, which suggests they have a good chance of winning. However, the inherent unpredictability of the contest means there is still significant uncertainty around the outcome."
    relevance: 0.75p
    date: 2026-03-03
}

evidence entity_investigator_0 {
    source: "Agent: entity_investigator (Claude API)"
    summary: "Betting odds are a meaningful but imperfect driver for Eurovision forecasting, with favorites winning ~40-45% historically. Italy is consistently competitive (top 10 finisher in recent years) but not a perennial favorite. Actual 2025 odds would depend on song selection outcomes not yet available. The 'betting_odds_rank' driver has moderate predictive validity but should be weighted alongside other factors like rehearsal reception and voting pattern analysis."
    relevance: 0.65p
    date: 2026-03-03
}

