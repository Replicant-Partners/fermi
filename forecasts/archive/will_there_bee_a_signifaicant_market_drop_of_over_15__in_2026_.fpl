question "will there bee a signifaicant market drop of over 15% in 2026?"

driver valuation_pressure continuous {
    distribution: triangular(0.3, 1.5, 2.5)
    unit: "multiplier"
    rationale: "As of late 2024, S&P 500 CAPE ratio ~30-35 (vs historical mean ~17). Elevated valuations increase correction risk. When CAPE >30, subsequent 10-year returns average lower and correction frequency increases by 15-40%. P50=1.15 reflects modest elevation of risk."
}

driver interest_rate_regime continuous {
    distribution: triangular(1.3, 2.4, 3.5)
    unit: "multiplier"
    rationale: "2026 will likely see rates in 3-5% range after 2023-2024 hiking cycle. Historical data shows transitions from low to higher rate environments increase correction probability. If rates remain elevated or rise further, equity risk premiums compress. P50=1.1 reflects moderate additional risk."
}

driver recession_probability binary {
    probability: 0.5p
    impact_multiplier: 3
    rationale: "Recessions strongly correlate with 15%+ corrections (occurred in ~80% of recession years). Base recession probability for 2026 ~20-30% given lag effects from 2023-2024 tightening. If recession occurs, correction probability increases 3-4x. Using 25% probability with 3.5x impact."
}

driver geopolitical_shock binary {
    probability: 0.4p
    impact_multiplier: 1.6
    rationale: "Major geopolitical events (war escalation, Taiwan crisis, major terrorist attack, etc.) can trigger sharp corrections. Historical frequency ~10-20% per year for market-moving events. Impact multiplier 2-3x when they occur. Using 15% probability with 2.5x impact."
}

driver ai_bubble_dynamics continuous {
    distribution: triangular(0.4, 1.7, 5)
    unit: "multiplier"
    rationale: "Significant AI investment boom 2023-2025 with concentration in mega-cap tech. Magnificent 7 stocks represent ~30% of S&P 500. Bubble dynamics and concentration risk increase correction probability. If AI monetization disappoints or regulatory pressure increases, correction risk elevated 20-60%."
}

