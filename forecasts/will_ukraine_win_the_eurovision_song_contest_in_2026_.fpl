```"
    relevance: 0.5p
    date: 2026-03-04
}

evidence sentiment_analyzer_0 {
    source: "Agent: sentiment_analyzer (Claude API)"
    summary: "The analysis suggests that while public sympathy for Ukraine in Eurovision voting countries remains high, there are indications of gradual decay in support over the next few years as the conflict drags on. Historical precedents and current sentiment trends point to a likely 20-30% decline in Ukraine's Eurovision vote share by 2025, though it will likely maintain a substantial advantage over its pre-2022 baseline."
    relevance: 0.85p
    date: 2026-03-04
}

model: (if war_status_2026 then 1.3 else 1.0) * sympathy_vote_strength * song_quality_percentile * (if voting_system_changes then 1.3 else 1.0) * competitor_strength

simulate 10000 iterations