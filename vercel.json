{
  "version": 2,
  "builds": [
    {
      "src": "api/health.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "api/execute.rs",
      "use": "@vercel/rust"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health"
    },
    {
      "src": "/api/execute",
      "dest": "/api/execute"
    }
  ],
  "env": {
    "RUST_LOG": "info"
  }
}
