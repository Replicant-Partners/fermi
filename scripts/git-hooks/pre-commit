#!/usr/bin/env bash
# Pre-commit hook: runs the linters that protect against the bug classes
# we've actually hit.
#
#   1. Migration lint       (PgBouncer-safety: BEGIN/COMMIT, multi-statement
#                            ADD CONSTRAINT, idempotency)
#   2. Schema lint          (qualified column refs in Rust SQL strings that
#                            no migration ever declared)
#   3. Owner-column lint    (v0.10.4 substrate: any new migration that
#                            adds a user-reference column must FK to
#                            users(user_id) or add to the allowlist)
#   4. Rollup contract      (write-orphaned columns: no handler may read a
#                            denormalised counter that nothing writes)
#
# Each runs independently — a failure in one doesn't suppress the other.
#
# Install: ./scripts/install-git-hooks.sh

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

failed=0

# ─── 1. Migration lint (only when migrations are staged) ──────────────
staged_migrations=$(git diff --cached --name-only --diff-filter=ACM \
                    | grep 'migrations/.*\.sql$' || true)
if [ -n "$staged_migrations" ]; then
    ./scripts/lint-migrations.sh $staged_migrations || failed=1
    # v0.10.4 substrate lint — always runs full-tree scan because it
    # only flags migrations >= 162 and the fix might live in a
    # cross-file allowlist edit, not a staged file.
    ./scripts/lint-owner-columns.sh || failed=1
fi

# ─── 2. Schema-consistency lint (only when .rs files are staged) ──────
staged_rs=$(git diff --cached --name-only --diff-filter=ACM \
            | grep '\.rs$' || true)
if [ -n "$staged_rs" ]; then
    ./scripts/lint-schema-consistency.py $staged_rs || failed=1
fi

# ─── 4. Rollup contract, offline tier (only when .rs files are staged) ──
#
# The tripwire for the `agents.total_executions` class: a column that
# exists, is correctly typed, is declared in SCHEMA_COLUMNS, and is
# permanently zero because no code path writes it. Six handlers
# independently reached for it and shipped zeros to users; every
# shape-based check above passed the whole time, because none of them look
# at values.
#
# Offline tier only — no database, so it's fast enough for a hook. The
# live content check is `./scripts/rollup_contract_live.sh`.
#
# Scoped to the roots the contract actually scans, so editing an unrelated
# .rs file doesn't pay for a test build.
if [ -n "$staged_rs" ] && echo "$staged_rs" | grep -qE '^src/(handlers|api|apps)/|^src/(rollup_trust|agent_economics|schema_trust)\.rs$'; then
    cargo test --test rollup_contract --quiet || failed=1
fi

exit $failed
