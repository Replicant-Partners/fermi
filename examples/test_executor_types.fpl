# Test file for Phase 1 Day 2-3 AST changes
# Tests: ExecutorType, driver_refs, depends_on, confidence_threshold

# Test 1: LLM executor with driver_refs
agent llm_agent {
    type: "research"
    query: "Test LLM executor for market research"
    executor: "llm"
    driver_refs: ["test_driver"]
    schedule: every 1 week
}

# Test 2: MCP executor with confidence_threshold
agent mcp_agent {
    type: "research"
    query: "Test MCP executor with external tools"
    executor: "mcp"
    confidence_threshold: 0.8
    schedule: every 1 day
}

# Test 3: Manual executor
agent manual_agent {
    type: "research"
    query: "Test manual executor - human provides evidence"
    executor: "manual"
}

# Test 4: Skill executor with depends_on
agent skill_agent {
    type: "sentiment"
    query: "Test skill executor for sentiment analysis"
    executor: "skill"
    depends_on: ["llm_agent", "mcp_agent"]
    schedule: every 3 days
}

# Test 5: Complete agent with all fields
agent complete_agent {
    type: "competitive"
    query: "Agent with all optional fields"
    executor: "llm"
    driver_refs: ["test_driver"]
    depends_on: ["manual_agent"]
    confidence_threshold: 0.75p
    schedule: every 2 weeks
}

# Test 6: Minimal agent (backward compatibility)
agent minimal_agent {
    type: "research"
    query: "Minimal agent - only required fields"
    schedule: every 1 week
}

# Minimal forecast to make file valid
driver test_driver continuous {
    distribution: triangular(1, 2, 3)
}

model: test_driver

simulate 1000
