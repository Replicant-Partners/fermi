# Infrastructure Costs Forecast Template
# Use this for cloud infrastructure cost projections

question "What will our AWS cloud infrastructure cost annually?"

# Compute resources
driver ec2_instances continuous {
    distribution: triangular(20, 50, 100)
    unit: "instances"
    rationale: "Number of EC2 instances needed for application workload"
}

driver instance_cost continuous {
    distribution: normal(150, 50)
    unit: "USD/month"
    rationale: "Average cost per instance (m5.xlarge mixed reserved/on-demand)"
}

# Database
driver rds_instances continuous {
    distribution: triangular(2, 5, 10)
    unit: "instances"
    rationale: "Primary and replica database instances"
}

driver rds_cost continuous {
    distribution: triangular(300, 500, 800)
    unit: "USD/month"
    rationale: "RDS instance cost including storage and backups"
}

# Storage and data transfer
driver s3_storage continuous {
    distribution: lognormal(1000, 500)
    unit: "GB"
    rationale: "S3 storage for user uploads and backups"
}

driver data_transfer continuous {
    distribution: triangular(500, 1000, 3000)
    unit: "GB/month"
    rationale: "Outbound data transfer"
}

driver transfer_cost_per_gb continuous {
    distribution: uniform(0.08, 0.12)
    unit: "USD/GB"
    rationale: "AWS data transfer pricing"
}

# Additional services
driver other_services continuous {
    distribution: triangular(1000, 2000, 5000)
    unit: "USD/month"
    rationale: "CloudFront, Route53, Lambda, monitoring, etc"
}

# Growth factor
driver monthly_growth continuous {
    distribution: normal(0.10, 0.05)
    unit: "ratio"
    rationale: "Month-over-month infrastructure growth"
}

# Calculate annual cost with growth
model: (
    # Base monthly cost
    (ec2_instances * instance_cost) +
    (rds_instances * rds_cost) +
    (s3_storage * 0.023) +  # S3 standard storage pricing
    (data_transfer * transfer_cost_per_gb) +
    other_services
) * 12 * (1 + monthly_growth)

simulate 10000 iterations
