// TEAM_PRIOR — Tournament win probability prior for a single national team.
// Six orthogonal factors with Cobb-Douglas response function.
// Parameterized: instantiated per team from data CSV.

param team_id: string
param team_name: string
param confederation: string
param group: string
param is_host: bool
param elo_current: real
param elo_trend: real
param gdp_per_capita_log: real
param population_log: real
param hdi_logit: real

question "Will {team_name} win the 2026 FIFA World Cup?"

// Factor inputs are standardized into roughly the same band as the X_k
// noise (sigma = sqrt(variance_share) ≈ 0.2-0.5) so the deterministic signal
// is comparable to stochastic. The executor adds +1.0 to each factor before
// substitution, so a deterministic contribution of ~0 means "neutral team",
// negative means "below the field", positive means "above".
//
// Calibration constants (Elo-mean=1700, Elo-spread=300, socio-shift=4.0,
// socio-scale=2.0) are chosen so each factor's deterministic component is
// roughly O(1) — comparable in scale to its noise term (sigma =
// sqrt(variance_share)). They are frozen at instantiation; BayesOps owns
// updates to the learnable elasticities, not these scaling constants.
// Polymarket sits outside this model as a base-rate divergence reference.

factor X1 "Socioeconomic Capital" {
    inputs: gdp_per_capita_log, population_log, hdi_logit
    // Center the weighted socio sum (empirical range across confederations
    // is ~[2.27, 2.94] with mean ~2.6) and scale so cross-confederation
    // spread maps to roughly [-0.5, +0.5] in factor-space — comparable to
    // X1's noise sigma = sqrt(0.25) = 0.5. UEFA lands near +0.4, CAF near
    // -0.5, with CONMEBOL/CONCACAF/AFC clustered in between.
    formulation: (0.4 * gdp_per_capita_log + 0.3 * population_log + 0.3 * hdi_logit - 2.6) / 0.7
    variance_share: 0.25
    update: static
}

factor X2 "Institutional Capacity" {
    inputs: player_penetration_rate, league_revenue_log, confederation_coefficient
    formulation: residual(0.4 * player_penetration_rate + 0.3 * league_revenue_log + 0.3 * confederation_coefficient, X1)
    variance_share: 0.20
    update: static
}

factor X3 "Dynamic Performance Signal" {
    inputs: elo_current, elo_trend, goal_difference, pass_completion, xg_delta
    // Z-score Elo against tournament-quality field (mean=1700, sd=300) and
    // mix in the remaining covariates (currently 0 until data fetch lands —
    // they fall out of the deterministic component and only contribute via
    // X3's noise term).
    formulation: residual(0.50 * (elo_current - 1700) / 300 + 0.10 * elo_trend + 0.15 * goal_difference + 0.10 * pass_completion + 0.15 * xg_delta, X1, X2)
    variance_share: 0.25
    update: per_match
}

factor X4 "Squad Quality Index" {
    inputs: market_value_concentration, top5_league_pct, squad_depth_score, avg_age_adjusted
    formulation: residual(0.25 * market_value_concentration + 0.30 * top5_league_pct + 0.25 * squad_depth_score + 0.20 * avg_age_adjusted, X1, X2, X3)
    variance_share: 0.15
    update: per_match
}

factor X5 "Tactical Efficiency" {
    inputs: shot_conversion_rate, defensive_duel_win_pct, pressing_intensity, set_piece_efficiency
    formulation: residual(0.25 * shot_conversion_rate + 0.25 * defensive_duel_win_pct + 0.25 * pressing_intensity + 0.25 * set_piece_efficiency, X1, X2, X3, X4)
    variance_share: 0.10
    update: per_match
}

factor X6 "Exogenous Context" {
    inputs: host_status, climate_delta, rest_days, altitude_delta
    formulation: residual(0.4 * host_status + 0.2 * climate_delta + 0.2 * rest_days + 0.2 * altitude_delta, X1, X2, X3, X4, X5)
    variance_share: 0.05
    update: per_fixture
}

estimate tournament_strength as: learnable(1.0, 0.2) * (X1 ^ learnable(0.25, 0.05)) * (X2 ^ learnable(0.20, 0.05)) * (X3 ^ learnable(0.25, 0.05)) * (X4 ^ learnable(0.15, 0.05)) * (X5 ^ learnable(0.10, 0.05)) * exp(learnable(0.05, 0.02) * X6)

// ─── BayesOps learnable drivers (Spec 23) ──────────────────────────────
//
// These drivers sit alongside the factor model. They give the BayesOps
// R-1 refit hook concrete observation streams to fit, separate from the
// factor-model elasticities (which use the params.<owner>_lN contract).
//
// won_rate: binary win/loss outcome per resolved match.
//   - Cold-start prior: Beta-like uniform in (0,1) via Triangular(0.2, 0.5, 0.8)
//   - Observations: 1.0 on win, 0.0 on loss, drawn from upstream resolution
//     outcomes whose winner_team_id matches this workspace's entity.
//   - After K matches: posterior tightens around the team's actual win rate.
//
// form_signal: continuous goal differential per resolved match (real-valued).
//   - Cold-start prior: centered at zero with moderate spread.
//   - Observations: outcome.goal_differential (positive = team scored more
//     than conceded that match).
//   - After K matches: posterior reflects recent form trend.
//
// Both drivers are sourced from upstream resolutions via the workspace
// dependency graph (workspace_dependencies). The Spec 23 R-1 refit hook
// fires on every resolution upstream of this workspace.

driver won_rate continuous {
    distribution: triangular(0.2, 0.5, 0.8)
    learnable: true
    feeds_from: {
        source: "upstream_resolutions",
        extractor: "binary_winner_id_match",
        config: {
            winner_field: "winner_team_id",
            match_value: "${workspace.entity_id}"
        }
    }
}

driver form_signal continuous {
    distribution: normal(0.0, 1.0)
    learnable: true
    feeds_from: {
        source: "upstream_resolutions",
        extractor: "scalar_field_value",
        config: {
            path: "goal_differential"
        }
    }
}

// ─── Research agents (BAYESOPS_CONTRACT.md §3, table) ──────────────────
//
// Each factor X_k has a designated curated agent that owns its inputs.
// `driver_refs` here points at the two learnable BayesOps drivers — the
// agents publish evidence into those streams, which then feed the R-1
// refit hook. The factor inputs themselves are param-bound at workspace
// instantiation (CSV from respawn_aligned.py), so the agents' real job is
// to keep those values fresh as the tournament progresses, not to bind
// them on first run.
//
// Without these blocks the cockpit's Drivers panel renders "⚠ No agents
// — assign one" on every driver, which makes the workspace look empty
// even though `workspace_agents` has the same four hires at the
// runtime-membership layer.

agent macro_data_agent {
    type: "research"
    query: "GDP per capita, population, HDI for {team_name}"
    executor: "llm"
    driver_refs: ["won_rate", "form_signal"]
    schedule: every 1 month
}

agent football_institution_agent {
    type: "research"
    query: "Player registration, league revenue, confederation strength for {team_name}"
    executor: "llm"
    driver_refs: ["won_rate", "form_signal"]
    schedule: every 1 month
}

agent football_analyst {
    type: "research"
    query: "Elo rating, recent form, squad quality, tactical metrics for {team_name}"
    executor: "llm"
    driver_refs: ["won_rate", "form_signal"]
    schedule: every 1 week
}

agent fixture_context_agent {
    type: "research"
    query: "Venue, weather, rest days, altitude for {team_name} upcoming fixtures"
    executor: "llm"
    driver_refs: ["won_rate", "form_signal"]
    schedule: every 3 days
}

output tournament_win_probability: derived
output reach_final_probability: derived
output reach_semifinal_probability: derived

simulate 10000 iterations
