# Fundraising Scenarios Forecast Template
# Use this for runway and capital requirements planning

question "How much runway will a seed round provide?"

# Fundraising parameters
driver round_size continuous {
    distribution: triangular(1000000, 2000000, 3000000)
    unit: "USD"
    rationale: "Target seed round size"
}

driver dilution continuous {
    distribution: uniform(0.15, 0.25)
    unit: "ratio"
    rationale: "Expected dilution percentage"
}

driver fundraising_costs continuous {
    distribution: triangular(50000, 100000, 150000)
    unit: "USD"
    rationale: "Legal fees, due diligence, founder travel"
}

# Monthly burn rate
driver team_size continuous {
    distribution: triangular(5, 8, 12)
    unit: "people"
    rationale: "Headcount during seed stage"
}

driver avg_fully_loaded_cost continuous {
    distribution: normal(12000, 3000)
    unit: "USD/month/person"
    rationale: "Fully loaded cost per employee (salary, benefits, equity, taxes)"
}

driver infrastructure_costs continuous {
    distribution: triangular(2000, 5000, 10000)
    unit: "USD/month"
    rationale: "Cloud infrastructure, tools, software"
}

driver marketing_spend continuous {
    distribution: triangular(5000, 10000, 20000)
    unit: "USD/month"
    rationale: "Marketing and customer acquisition"
}

driver other_operating continuous {
    distribution: uniform(3000, 8000)
    unit: "USD/month"
    rationale: "Office, insurance, professional services, misc"
}

# Revenue (if any)
driver monthly_revenue continuous {
    distribution: triangular(0, 5000, 20000)
    unit: "USD/month"
    rationale: "Early revenue from pilot customers"
}

driver revenue_growth continuous {
    distribution: normal(0.20, 0.10)
    unit: "ratio/month"
    rationale: "Month-over-month revenue growth rate"
}

# Calculate runway in months
model: (round_size - fundraising_costs) / (
    (team_size * avg_fully_loaded_cost) +
    infrastructure_costs +
    marketing_spend +
    other_operating -
    (monthly_revenue * (1 + revenue_growth))
)

simulate 10000 iterations
