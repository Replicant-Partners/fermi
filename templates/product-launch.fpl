# Product Launch Forecast Templates
# Use these for new product user/revenue projections

question "How many users will our mobile app have in the first year?"

# Market and awareness drivers
driver target_market continuous {
    distribution: triangular(1000000, 5000000, 10000000)
    unit: "potential users"
    rationale: "Total addressable market for mobile app"
}

driver awareness_rate continuous {
    distribution: normal(0.05, 0.02)
    unit: "ratio"
    rationale: "Percentage of market that becomes aware through marketing"
}

driver download_rate continuous {
    distribution: triangular(0.10, 0.20, 0.40)
    unit: "ratio"
    rationale: "Percentage of aware users who download"
}

driver activation_rate continuous {
    distribution: uniform(0.25, 0.50)
    unit: "ratio"
    rationale: "Users who complete onboarding"
}

driver retention_rate continuous {
    distribution: normal(0.40, 0.10)
    unit: "ratio"
    rationale: "30-day retention rate"
}

model: target_market * awareness_rate * download_rate * activation_rate * retention_rate

simulate 10000 iterations
