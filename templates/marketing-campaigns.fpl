# Marketing Campaign ROI Forecast Template
# Use this for digital marketing campaign planning

question "What will be the ROI of our digital marketing campaign?"

# Campaign spend
driver campaign_budget continuous {
    distribution: triangular(20000, 50000, 100000)
    unit: "USD"
    rationale: "Total marketing budget for campaign"
}

driver cost_per_click continuous {
    distribution: normal(2.50, 0.75)
    unit: "USD"
    rationale: "Average CPC across channels (Google, Facebook, LinkedIn)"
}

# Funnel metrics
driver landing_page_conversion continuous {
    distribution: uniform(0.02, 0.05)
    unit: "ratio"
    rationale: "Percentage of clicks that convert to leads"
}

driver lead_to_customer continuous {
    distribution: triangular(0.10, 0.20, 0.35)
    unit: "ratio"
    rationale: "Lead qualification and sales conversion rate"
}

# Customer value
driver avg_customer_value continuous {
    distribution: lognormal(5000, 2000)
    unit: "USD"
    rationale: "Lifetime value of acquired customer"
}

driver customer_margin continuous {
    distribution: uniform(0.60, 0.80)
    unit: "ratio"
    rationale: "Gross margin on customer revenue"
}

# Calculate ROI
model: (
    # Total clicks
    (campaign_budget / cost_per_click) *
    # Leads generated
    landing_page_conversion *
    # Customers acquired
    lead_to_customer *
    # Revenue per customer
    avg_customer_value *
    # Margin
    customer_margin
    # Subtract cost
) - campaign_budget

simulate 10000 iterations
