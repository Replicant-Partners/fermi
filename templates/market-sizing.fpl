# Market Sizing Forecast Template
# Use this for TAM/SAM/SOM analysis

question "What is the market opportunity for our B2B SaaS product?"

# Total Addressable Market (TAM)
driver total_companies continuous {
    distribution: triangular(500000, 1000000, 2000000)
    unit: "companies"
    rationale: "Total companies in target industry globally"
}

driver tam_avg_spend continuous {
    distribution: lognormal(5000, 2000)
    unit: "USD/year"
    rationale: "Average annual spend on similar solutions"
}

# Serviceable Addressable Market (SAM)
driver geographic_reach continuous {
    distribution: uniform(0.30, 0.50)
    unit: "ratio"
    rationale: "Percentage of companies in regions we can serve"
}

driver company_size_fit continuous {
    distribution: triangular(0.15, 0.25, 0.40)
    unit: "ratio"
    rationale: "Percentage of companies in our target size range (50-500 employees)"
}

# Serviceable Obtainable Market (SOM)
driver market_share_achievable continuous {
    distribution: triangular(0.01, 0.03, 0.08)
    unit: "ratio"
    rationale: "Realistic market share in 3-5 years given competition"
}

# Calculate TAM → SAM → SOM
model: total_companies *
       tam_avg_spend *
       geographic_reach *
       company_size_fit *
       market_share_achievable

simulate 10000 iterations
