# Hiring Costs Forecast Template
# Use this for team expansion cost planning

question "What will it cost to expand our engineering team this year?"

# Team size
driver engineers_to_hire continuous {
    distribution: triangular(5, 10, 15)
    unit: "people"
    rationale: "Planned engineering headcount growth"
}

# Compensation
driver base_salary continuous {
    distribution: normal(120000, 25000)
    unit: "USD/year"
    rationale: "Average base salary for mid-level engineer"
}

driver equity_value continuous {
    distribution: triangular(10000, 20000, 40000)
    unit: "USD/year"
    rationale: "Annualized value of equity grants"
}

driver benefits_rate continuous {
    distribution: uniform(0.25, 0.35)
    unit: "ratio"
    rationale: "Benefits as percentage of base (healthcare, 401k, etc)"
}

# Recruiting costs
driver recruiter_fee continuous {
    distribution: triangular(15000, 20000, 30000)
    unit: "USD/hire"
    rationale: "Agency recruiter fee or internal recruiting cost per hire"
}

driver onboarding_cost continuous {
    distribution: uniform(5000, 10000)
    unit: "USD/hire"
    rationale: "Equipment, training, ramp time cost"
}

# Productivity ramp
driver time_to_full_productivity continuous {
    distribution: triangular(2, 3, 6)
    unit: "months"
    rationale: "Time until engineer is fully productive"
}

# Calculate annual cost
model: engineers_to_hire * (
    # Total compensation
    base_salary +
    equity_value +
    (base_salary * benefits_rate) +
    # One-time costs
    recruiter_fee +
    onboarding_cost
) *
# Adjust for ramp time in first year
(1 - (time_to_full_productivity / 24))

simulate 10000 iterations
