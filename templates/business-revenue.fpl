# Business Revenue Forecast Template
# Use this for quarterly or annual revenue projections

question "What will our Q4 2024 SaaS revenue be?"

# Customer base drivers
driver existing_customers continuous {
    distribution: triangular(5000, 8000, 12000)
    unit: "customers"
    rationale: "Current customer base with growth projection"
}

driver monthly_churn continuous {
    distribution: uniform(0.02, 0.05)
    unit: "ratio"
    rationale: "Historical churn rate range"
}

driver new_signups continuous {
    distribution: normal(500, 150)
    unit: "customers/month"
    rationale: "Monthly signup rate based on marketing spend"
}

# Pricing drivers
driver avg_plan_price continuous {
    distribution: triangular(49, 99, 299)
    unit: "USD/month"
    rationale: "Tiered pricing: Starter, Pro, Enterprise"
}

driver upsell_rate continuous {
    distribution: uniform(0.10, 0.25)
    unit: "ratio"
    rationale: "Percentage of customers who upgrade"
}

driver enterprise_deals continuous {
    distribution: triangular(2, 5, 10)
    unit: "deals"
    rationale: "Large enterprise contracts per quarter"
}

driver enterprise_value continuous {
    distribution: triangular(50000, 100000, 250000)
    unit: "USD"
    rationale: "Average enterprise contract value"
}

# Model: Calculate quarterly SaaS revenue
model: (
    # Net customers after churn and new signups
    (existing_customers * (1 - monthly_churn) + new_signups) *
    # Base MRR
    avg_plan_price *
    # With upsells
    (1 + upsell_rate) *
    # Multiply by 3 months
    3
) +
# Plus enterprise revenue
(enterprise_deals * enterprise_value)

simulate 10000 iterations
