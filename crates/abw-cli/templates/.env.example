# Copy to .env for local overrides. The CLI reads these as fallbacks
# after ~/.abw/credentials (set by `abw login`).

# Override the ABW base URL (defaults to https://agent-bestiary.world).
# Use this for local dev: ABW_BASE_URL=http://localhost:3000
# ABW_BASE_URL=

# Bypass the credential store with an explicit API key.
# Mint one at $ABW_BASE_URL/settings/api-keys, or use `abw login` instead.
# ABW_API_TOKEN=
