forecast "AMD Q4 2024 Revenue" {
    driver gpu_units triangular(2000000, 3200000, 5000000)
    driver market_share normal(0.15, 0.05)
    driver avg_price triangular(800, 1200, 2000)

    estimate gpu_units * market_share * avg_price
}

forecast "Product Launch Success" {
    driver base_users normal(100000, 20000)
    driver growth_rate lognormal(1.5, 0.3)
    driver conversion uniform(0.02, 0.08)

    estimate base_users * growth_rate * conversion
}
