16:      for (const driver of drivers) {
17:        const sample = this.sampleFromDistribution(driver);
18:        value *= sample;
19:      }
21:      results.push(value);
22:    }
24:    results.sort((a, b) => a - b);
26:    const p10 = results[Math.floor(iterations * 0.1)];
27:    const p50 = results[Math.floor(iterations * 0.5)];
28:    const p90 = results[Math.floor(iterations * 0.9)];
29:    const mean = results.reduce((sum, v) => sum + v, 0) / iterations;
30:    const variance = results.reduce((sum, v) => sum + Math.pow(v - mean, 2), 0) / iterations;
31:    const stdDev = Math.sqrt(variance);
33:    const histogram = this.createHistogram(results, 50);
35:    return {
36:      p10,
37:      p50,
38:      p90,
39:      mean,
40:      stdDev,
41:      probabilityAboveTarget: 0,
42:      histogram,
43:    };
44:  }
46:  private sampleFromDistribution(driver: ForecastDriver): number {
47:    switch (driver.distributionType) {
48:      case 'triangular':
49:        return this.sampleTriangular(
50:          driver.parameters.low!,
51:          driver.parameters.mode!,
52:          driver.parameters.high!
53:        );
54:      case 'normal':
55:        return this.sampleNormal(driver.parameters.mean!, driver.parameters.stdDev!);
56:      case 'uniform':
57:        return this.sampleUniform(driver.parameters.low!, driver.parameters.high!);
58:      case 'beta':
59:        return this.sampleBeta(driver.parameters.alpha!, driver.parameters.beta!);
60:      default:
61:        return driver.parameters.mean || 1;
62:    }
63:  }
65:  private sampleTriangular(low: number, mode: number, high: number): number {
66:    const u = Math.random();
67:    const f = (mode - low) / (high - low);
69:    if (u < f) {
70:      return low + Math.sqrt(u * (high - low) * (mode - low));
71:    } else {
72:      return high - Math.sqrt((1 - u) * (high - low) * (high - mode));
73:    }
74:  }
