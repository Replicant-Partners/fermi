## The Forecasting Programming Language (FPL)

### Core Syntax Design

```rust
// ============================================
// FPL: Forecasting Programming Language
// ============================================

// QUESTION DECLARATION (Entry point)
question "Will ASTS reach $200M revenue by 2026-12-31?" {
    domain: satellite_telecom
    resolution_criteria: "Audited annual revenue ≥ $200M in fiscal 2026"
    target_date: 2026-12-31
    
    // Base rate (outside view)
    base_rate: reference_class(
        "pre-revenue satellite companies reaching 24mo revenue targets",
        confidence: medium
    )
    
    // Fermi decomposition (inside view)
    model: multiplicative {
        revenue = market_tam 
                × market_share 
                × arpu 
                × (months_active / 12)
    }
}

// DRIVER DEFINITIONS
driver market_tam: continuous {
    name: "Total Addressable Market"
    unit: USD
    
    // Distribution specification
    dist: triangular {
        p5:  2_000_000_000,
        p50: 5_000_000_000,
        p95: 7_000_000_000
    }
    
    // Rationale (versioned, appears in notebook)
    rationale: """
    Conservative estimate based on:
    - IoT connectivity growth
    - Maritime/aviation demand
    - Emergency services adoption
    
    FCC approval (2024-11-01) reduces regulatory risk,
    accelerating addressable market expansion.
    """
    
    // AGENT ATTACHMENT
