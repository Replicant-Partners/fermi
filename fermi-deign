## Domain Model (Rust)

```rust
// Core entities

struct Forecast {
    id: ForecastId,
    question: String,
    resolution_criteria: String,
    target_date: NaiveDate,
    
    // Outside view
    base_rate: Option<BaseRate>,
    
    // Inside view
    drivers: Vec<Driver>,
    model: Option<FermiModel>,
    
    // Results
    current_probability: Option<Probability>,
    last_simulation: Option<SimulationResult>,
    
    // Resolution
    resolved: bool,
    outcome: Option<Outcome>,
    brier_score: Option<f64>,
    
    // Versioning
    version: Version,
    version_history: Vec<ForecastVersion>,
}

struct Driver {
    id: DriverId,
    name: String,
    driver_type: DriverType,  // Continuous | Binary
    distribution: Distribution,
    evidence: Vec<Evidence>,
    attached_agents: Vec<AgentAttachment>,
    constraints: Vec<Constraint>,
}

enum Distribution {
    Triangular { p5: f64, p50: f64, p95: f64 },
    Normal { mean: f64, stddev: f64 },
    Lognormal { median: f64, sigma: f64 },
}

struct Evidence {
    source: String,
    content: String,
    impact_direction: ImpactDirection,  // Increases/Decreases
    impact_magnitude: ImpactMagnitude,  // Strong/Moderate/Weak
    added_by: AddedBy,  // User | Agent
}

struct AgentAttachment {
    agent_type: AgentType,
    query: String,
    schedule: Schedule,
    triggers: Vec<Trigger>,
}
```

