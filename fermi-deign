        unit: "months"
    }
    
    agents: [
        supply_chain_analyst {
            query: "Apple Vision Pro 2 supply chain rumors Sony micro-OLED production",
            schedule: weekly(monday, 08:00),
            sources: ["supply_chain_asia", "nikkei", "analyst_reports"]
        }
    ]
}

driver sales_performance: discrete {
