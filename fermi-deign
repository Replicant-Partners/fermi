# Example FPL Forecasts

This document provides complete, realistic examples of forecasts written in the Forecasting Programming Language (FPL). These demonstrate the DSL syntax, agent attachments, driver modeling, and simulation configuration.

## Example 1: AST SpaceMobile Revenue Forecast

```fpl
// AST SpaceMobile revenue prediction for Q4 2026
question "Will ASTS reach $200M revenue by 2026-12-31?" {
    domain: satellite_telecom
    resolution_date: 2026-12-31
    resolution_criteria: """
        Resolves YES if ASTS reports >= $200M in cumulative revenue 
        in their Q4 2026 earnings (GAAP or non-GAAP).
        Source: SEC 10-K/10-Q filings or official earnings releases.
    """
    
    base_rate: reference_class(
        "Pre-revenue satellite companies reaching 24-month revenue targets",
        historical_frequency: 0.15,
        confidence: medium,
        sources: [
            "Iridium: missed initial targets by 36 months",
            "Globalstar: missed by 18 months", 
            "OneWeb: bankruptcy, restructure"
        ]
    )
    
    metadata: {
        created: 2025-01-15T09:00:00Z,
        analyst: "user_123",
        tags: ["space", "telecom", "growth"],
        market_link: "polymarket.com/event/asts-200m-revenue"
    }
}

// Driver 1: Total Addressable Market
driver market_tam: continuous {
    name: "Total Addressable Market ($)"
    description: "Global satellite-to-phone connectivity market size by end of 2026"
    
    dist: triangular {
        p5:  2_000_000_000,   // Conservative: niche adoption
        p50: 5_000_000_000,   // Base case: moderate growth
        p95: 7_000_000_000,   // Optimistic: rapid expansion
        unit: "USD"
    }
    
    constraints: [
        positive,
        {market_tam * market_share <= 10_000_000_000}  // Sanity check
    ]
    
    agents: [
        research_analyst {
            query: "satellite direct-to-device connectivity TAM 2026 Iridium Globalstar AST market size",
            schedule: weekly(monday, 09:00),
            sources: ["statista", "gartner", "sec_filings"],
            output_format: "evidence_card"
        },
        market_researcher {
            query: "smartphone satellite connectivity adoption rates 2024-2026",
            schedule: biweekly(tuesday, 14:00),
            focus: "consumer_adoption"
        }
    ]
    
    evidence: [
        {
            date: 2025-01-10,
            source: "Iridium Q3 2024 Earnings",
            content: "Management commentary suggests $4-6B TAM for D2D by 2026",
            impact: bullish,
            confidence: high
        }
    ]
}

// Driver 2: Market Share
driver market_share: continuous {
    name: "ASTS Market Share (%)"
    description: "Percentage of TAM captured by AST SpaceMobile"
    
    dist: triangular {
        p5:  0.01,   // 1% - major delays or tech issues
        p50: 0.05,   // 5% - base case with 2-3 carrier deals
        p95: 0.12,   // 12% - optimistic with many partnerships
        unit: "percentage"
    }
    
    constraints: [
        {market_share >= 0.0},
        {market_share <= 0.20}  // Can't exceed 20% in first commercial year
    ]
    
    agents: [
        competitive_analyst {
            query: "AST SpaceMobile carrier partnerships agreements Vodafone AT&T",
            schedule: weekly(wednesday, 10:00),
            competitors: ["Lynk Global", "Starlink", "Apple-Globalstar"]
        },
        sentiment_analyst {
            query: "ASTS satellite launch success mission updates",
            schedule: daily(16:00),
            sources: ["twitter", "reddit:r/ASTSpaceMobile", "spacenews"]
        }
    ]
}

// Driver 3: Average Revenue Per User
driver arpu: continuous {
    name: "Average Revenue Per User ($/month)"
    description: "Revenue per subscriber per month from satellite connectivity"
    
    dist: lognormal {
        median: 15.0,   // Base case: $15/month
        sigma: 0.5,     // Moderate uncertainty
        unit: "USD"
    }
    
    constraints: [
        {arpu >= 5.0},    // Minimum viable price point
        {arpu <= 50.0}    // Maximum consumer willingness to pay
    ]
    
    agents: [
        pricing_analyst {
            query: "satellite connectivity pricing consumer willingness to pay telco",
            schedule: monthly(first_monday, 09:00)
        }
    ]
}

// Driver 4: Time in Market
driver time_factor: continuous {
    name: "Effective Months in Market"
    description: "Number of revenue-generating months in 2026 (accounts for launch delays)"
    
    dist: triangular {
        p5:  3,    // Major delays, Q4 launch only
        p50: 8,    // Launch in May, ramp through year
        p95: 12,   // Jan launch, full year revenue
        unit: "months"
    }
    
    constraints: [
        {time_factor >= 0},
        {time_factor <= 12}
    ]
    
    agents: [
        regulatory_monitor {
            query: "AST SpaceMobile FCC approval launch schedule satellite deployment",
            schedule: weekly(friday, 11:00),
            sources: ["fcc.gov", "sec_filings"]
        },
        technical_analyst {
            query: "ASTS Block 2 satellite production manufacturing schedule",
            schedule: biweekly(thursday, 15:00)
        }
    ]
}

// Fermi Model: Revenue Decomposition
model revenue_model {
    name: "ASTS Revenue Decomposition"
    formula: (market_tam * market_share) * (time_factor / 12.0)
    
    unit: "USD"
    
    sensitivity_analysis: true
    
    // Fermi will explain: "Your revenue estimate depends on these 4 factors:
    // 1. How big is the total market? (TAM)
    // 2. What slice can ASTS capture? (market share)  
    // 3. How much do you charge per user? (ARPU - implicit in TAM sizing)
    // 4. How long are they in market? (time factor)
    //
    // Currently your p50 estimate is: $5B * 5% * 8/12 = $166M
    // That's BELOW your $200M target. You're estimating ~40% probability."
}

// Monte Carlo Simulation
simulate: monte_carlo {
    iterations: 10_000
    seed: 42  // Reproducible for testing
    
    output: {
        // Primary question
        probability: p(revenue_model >= 200_000_000),
        
        // Distribution visualization  
        distribution: histogram(bins: 50),
        percentiles: [5, 25, 50, 75, 95],
        
        // Sensitivity analysis
        sensitivity: {
            method: variance_decomposition,
            rank_drivers: true
        },
        
        // Scenario analysis
        scenarios: [
            {
                name: "bull_case",
                conditions: {market_share: p75, time_factor: p75},
                probability: p(revenue_model >= 200_000_000)
            },
            {
                name: "bear_case", 
                conditions: {market_share: p25, time_factor: p25},
                probability: p(revenue_model >= 200_000_000)
            }
        ]
    }
    
    // Update forecast probability
    update_probability: true
}

// Fermi Coaching Notes
// This forecast will trigger Fermi guidance:
// 1. "Your base rate (15%) and model probability (~40%) diverge. 
//     Which evidence makes ASTS different from historical satellite companies?"
// 2. "Market share at p95=12% seems optimistic for Year 1. What partnerships 
//     justify this vs. Iridium's slow ramp?"
// 3. "Consider adding a 'subscriber_count' driver to make ARPU explicit."
```

