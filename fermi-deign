## Example 4: Geopolitical Forecast

```fpl
question "Will China invade Taiwan by 2027?" {
    domain: geopolitics
    resolution_date: 2027-12-31
    resolution_criteria: """
        Resolves YES if PLA conducts military invasion/blockade of Taiwan 
        with intent to forcibly unify.
        Does NOT resolve for: exercises, cyberattacks, or economic coercion.
    """
    
    base_rate: reference_class(
        "Territorial invasions by major powers 1990-2024",
        historical_frequency: 0.05,  // Rare but precedented (Crimea, Iraq)
        confidence: medium,
        note: "Small sample size, high impact events"
    )
}

driver military_readiness: continuous {
    name: "PLA Readiness Index (0-100)"
    
    dist: triangular {
        p5: 40,   // Significant capability gaps
        p50: 60,  // Improving but incomplete
        p95: 85,  // Near-peer capability
        unit: "index"
    }
    
    agents: [
        defense_analyst {
            query: "PLA amphibious capability Taiwan strait naval exercises",
            schedule: weekly(wednesday, 11:00),
            sources: ["janes", "csis", "rand", "pentagon_reports"],
            classification: "open_source_only"
        }
    ]
}

driver us_commitment: discrete {
    name: "US Defense Commitment Level"
    
    dist: categorical {
        low: 0.20,        // Strategic ambiguity weakens
        moderate: 0.60,   // Status quo maintained
        high: 0.20        // Explicit defense treaty
    }
    
    agents: [
        geopolitical_analyst {
            query: "US Taiwan defense policy strategic ambiguity military aid",
            schedule: biweekly(monday, 09:00)
        }
    ]
}

driver economic_cost: continuous {
    name: "Estimated Economic Cost to China (% GDP)"
    
    dist: triangular {
        p5: 5,    // Quick victory, limited sanctions
        p50: 15,  // Protracted conflict, sanctions
        p95: 30,  // Failed invasion, global isolation
        unit: "percentage"
    }
}

// Complex conditional model
model invasion_likelihood {
    formula: if(
        military_readiness >= 70 
        AND us_commitment == "low"
        AND economic_cost <= 20,
        0.40,  // Conditions favorable
        0.05   // Conditions unfavorable, revert to base rate
    )
}

simulate: monte_carlo {
    iterations: 50_000  // More iterations for rare events
    output: {
        probability: p(invasion_likelihood >= 0.30),
        percentiles: [1, 5, 10, 50, 90, 95, 99],
        
        scenarios: [
            {
                name: "deterrence_holds",
                conditions: {us_commitment: "high", military_readiness: p25}
            },
            {
                name: "window_of_opportunity",
                conditions: {us_commitment: "low", military_readiness: p75}
            }
        ]
    }
}

// Epistemic uncertainty note
metadata: {
    confidence: low,
    note: """
        This forecast has high epistemic uncertainty due to:
        1. Limited historical data on peer conflicts
        2. Opacity of CCP decision-making
        3. Rapidly changing military balance
        
        Base rate may be misleading. Consider this a structured 
        way to think about key factors rather than precise probability.
    """
}
```

