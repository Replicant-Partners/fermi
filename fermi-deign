use yrs::{Doc, Text, Map, Array};  // Yjs in Rust
use automerge::Automerge;          // Alternative CRDT

struct CollaborativeForecast {
    // CRDT document (syncs across all clients)
    doc: Doc,
    
    // Each forecaster has their own probability estimate
    // But they share: drivers, evidence, discussion
    forecasters: Map<UserId, ForecastEstimate>,
    
    // Shared notebook (CRDT Text)
    notebook: Text,
    
    // Shared drivers (CRDT Map)
    drivers: Map<DriverId, Driver>,
    
    // Evidence is append-only (CRDT Array)
    evidence: Array<Evidence>,
    
    // Comments/discussion (CRDT Text + threading)
    discussion: Array<Comment>,
    
    // Real-time presence
    presence: Map<UserId, Presence>,
}

struct ForecastEstimate {
    user_id: UserId,
    probability: f64,
    rationale: String,
    last_updated: Timestamp,
    
    // User's own simulation (not shared until they choose to)
    local_simulation: Option<SimulationResult>,
}

// Example: Team forecast on "Will ASTS reach $200M?"
let forecast = CollaborativeForecast {
    forecasters: {
        "alice": ForecastEstimate { probability: 0.42, ... },
        "bob":   ForecastEstimate { probability: 0.38, ... },
        "carol": ForecastEstimate { probability: 0.51, ... }
