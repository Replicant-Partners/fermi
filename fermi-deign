## Fermi as Constraint-Based Learning Coach

### Problem-Solving Heuristics for Probabilistic Reasoning

```rust
// Fermi's coaching engine uses constraint-based learning
// Not "here's the answer" but "here are the constraints"

struct FermiCoach {
    ontology: ForecastingOntology,
    heuristics: Vec<ProblemSolvingHeuristic>,
    constraint_solver: ConstraintSolver
}

// Example: User creates driver with weird distribution
driver weird: continuous {
    dist: normal {
        mean: 100,
        stddev: 200  // ← StdDev > Mean for positive-only value
    }
}

// Fermi detects constraint violation:
impl FermiCoach {
    fn validate_driver(&self, driver: &Driver) -> ValidationResult {
        let mut violations = vec![];
        
        // Constraint: Normal distribution allows negative values
        // But this driver should be positive-only
        if driver.dist == Normal && driver.can_be_negative == false {
            violations.push(Constraint {
                rule: "Normal dist allows negatives",
                severity: Warning,
                suggestion: "Use lognormal for positive-only values",
                heuristic: DistributionSelection,
                educational: "Normal: symmetric, unbounded
                             Lognormal: positive-only, right-skewed
                             Triangular: bounded, flexible shape"
            });
        }
        
        // Constraint: StdDev > Mean suggests high uncertainty
        if let Normal { mean, stddev } = driver.dist {
            if stddev > mean {
                violations.push(Constraint {
                    rule: "StdDev > Mean indicates >100% uncertainty",
                    severity: Warning,
                    suggestion: "Consider triangular with explicit bounds",
                    heuristic: UncertaintyQuantification,
                    educational: "When uncertain about shape, triangular
                                 forces you to define min/mode/max explicitly"
                });
            }
        }
        
        ValidationResult { violations }
    }
}

// Displayed to user:
