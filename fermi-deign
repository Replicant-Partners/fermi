## Part 3: Proposed Domain Model

### Core Entities (Tetlock-Aligned)

```typescript
// ============================================
// DOMAIN MODEL - Superforecasting First
// ============================================

/**
 * A FORECAST is a probability estimate of a future outcome
 * Core: Question + Probability + Justification
 */
interface Forecast {
  id: ForecastId
  
  // Question (clairvoyance test)
  question: string
  resolutionCriteria: string  // How we'll know the answer
  closeDate: Date             // When we stop accepting updates
  resolveDate: Date           // When we'll know the outcome
  
  // Current estimate (primary)
  probability: Probability    // 0.0 to 1.0 (can be null initially)
  lastUpdated: Date
  updateCount: number         // Tracking frequency
  
  // Justification (secondary - supports the probability)
  justificationMode: 'quick' | 'fermi' | 'reference-class' | 'hybrid'
  
  // Outside view (Tetlock: start here)
  baseRate?: BaseRate
  
  // Inside view (Tetlock: adjust from base rate)
  fermiDecomposition?: FermiModel  // Optional detailed model
  
  // Evidence
  evidence: Evidence[]
  updateHistory: ProbabilityUpdate[]
  
  // Resolution (after close)
  resolved: boolean
  outcome?: boolean
  brierScore?: number
  
  // Metadata
  creator: UserId
  team?: TeamId
  tags: string[]
  visibility: 'private' | 'team' | 'public'
}

/**
 * BASE RATE: Outside view / reference class
 * Tetlock: Start here BEFORE inside analysis
 */
interface BaseRate {
  referenceClass: string      // "Tech IPOs in recession"
  historicalFrequency: number // 0.0 to 1.0
  sampleSize: number          // How many cases?
  source: string              // Where did this come from?
  confidence: 'high' | 'medium' | 'low'
  generatedBy: 'ai' | 'user' | 'database'
}

/**
 * FERMI MODEL: Inside view / detailed decomposition
 * Optional - only if user wants to justify via drivers
 */
interface FermiModel {
  approach: 'multiplicative' | 'additive' | 'scenario-weighted'
  drivers: Driver[]
  
  // Simulation results (if run)
  simulation?: MonteCarloResult
}

interface Driver {
  id: DriverId
  name: string
  description: string
  
  // Continuous drivers (ranges)
  type: 'continuous' | 'binary'
  distribution?: DistributionSpec
  
  // Binary drivers (events)
  eventProbability?: number
  
  // Justification
  evidence: Evidence[]
  researchAgents: AgentConfig[]
}

/**
 * PROBABILITY UPDATE: Track belief revision
 * Tetlock: Superforecasters update frequently
 */
interface ProbabilityUpdate {
  timestamp: Date
  oldProbability: number
  newProbability: number
  delta: number
  reason: string              // "New poll released", "Expert opinion changed"
  triggerType: 'manual' | 'agent' | 'threshold' | 'coach-suggestion'
  newEvidence?: Evidence[]
}

/**
 * EVIDENCE: Supporting information
 * Can attach to forecast OR driver
 */
interface Evidence {
  id: EvidenceId
  type: 'research' | 'data' | 'expert' | 'market' | 'news'
  content: string
  source: string
  url?: string
  confidence: 'high' | 'medium' | 'low'
  timestamp: Date
  
  // Impact on belief
  direction?: 'increases' | 'decreases' | 'neutral'
  magnitude?: 'strong' | 'moderate' | 'weak'
}
