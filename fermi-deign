// ASTS Revenue Forecast
question "Will ASTS reach $200M revenue by 2026-12-31?" {
    domain: satellite_telecom
    resolution_criteria: "Audited annual revenue ≥ $200M in fiscal 2026"
    target_date: 2026-12-31
    
