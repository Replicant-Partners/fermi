            .footer("Tap to expand")
    }
    
    fn render_ar(&self, cx: &mut ViewContext) -> ARWidget {
        // Floating holographic chart in AR space
        ARWidget::new()
            .position(eye_level + vec3(0, 0.5, -1.0))
            .content(holographic_histogram(self.histogram_data))
            .interactive(pinch_to_zoom, tap_to_details)
    }
