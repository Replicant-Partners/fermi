# Commit with conventional commit format
git commit -m "feat(dsl): add constraint violation detection

- Parse constraint expressions in FPL
- Evaluate constraints during simulation  
- Return violations with helpful error messages

Closes #42"

# Push to remote
git push origin feature/fermi-constraint-engine

# Create PR
gh pr create --title "Add constraint violation detection" \
             --body "Implements Fermi coaching for constraint violations"
