## 5. Database Setup

```bash
# Create migrations directory
mkdir -p migrations

cat > migrations/001_init.sql << 'EOF'
-- Users
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    username VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

-- Forecasts
CREATE TABLE forecasts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    question TEXT NOT NULL,
    resolution_criteria TEXT NOT NULL,
    target_date TIMESTAMPTZ NOT NULL,
    domain VARCHAR(100),
    
    -- Current state
    probability DOUBLE PRECISION,
    
    -- Resolution
    resolved BOOLEAN NOT NULL DEFAULT FALSE,
    outcome BOOLEAN,
    resolved_at TIMESTAMPTZ,
    brier_score DOUBLE PRECISION,
    
    -- Metadata
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    
    -- JSONB for flexibility
    base_rate JSONB,
    metadata JSONB
);

CREATE INDEX idx_forecasts_user_id ON forecasts(user_id);
CREATE INDEX idx_forecasts_resolved ON forecasts(resolved);
CREATE INDEX idx_forecasts_domain ON forecasts(domain);

-- Drivers
CREATE TABLE drivers (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    forecast_id UUID NOT NULL REFERENCES forecasts(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    driver_type VARCHAR(50) NOT NULL, -- 'continuous' or 'binary'
    
    -- Distribution (JSONB for flexibility)
    distribution JSONB NOT NULL,
    
    -- Metadata
    rationale TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_drivers_forecast_id ON drivers(forecast_id);

-- Evidence
CREATE TABLE evidence (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    driver_id UUID NOT NULL REFERENCES drivers(id) ON DELETE CASCADE,
    source VARCHAR(255) NOT NULL,
    content TEXT NOT NULL,
    evidence_type VARCHAR(50) NOT NULL,
    
    -- Impact
    impact_direction VARCHAR(20), -- 'increases', 'decreases', 'neutral'
    impact_magnitude VARCHAR(20), -- 'strong', 'moderate', 'weak'
    
    -- Metadata
    added_by UUID REFERENCES users(id),
    agent_type VARCHAR(100), -- If added by agent
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    
    -- Full data
    metadata JSONB
);

CREATE INDEX idx_evidence_driver_id ON evidence(driver_id);

-- Agent Schedules
CREATE TABLE agent_schedules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    driver_id UUID NOT NULL REFERENCES drivers(id) ON DELETE CASCADE,
    agent_type VARCHAR(100) NOT NULL,
    query TEXT NOT NULL,
    schedule VARCHAR(50) NOT NULL, -- 'daily', 'weekly', 'monthly', 'on-demand'
    active BOOLEAN NOT NULL DEFAULT TRUE,
    last_run TIMESTAMPTZ,
    next_run TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_agent_schedules_driver_id ON agent_schedules(driver_id);
CREATE INDEX idx_agent_schedules_next_run ON agent_schedules(next_run) WHERE active = TRUE;

-- Simulations (history)
CREATE TABLE simulations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    forecast_id UUID NOT NULL REFERENCES forecasts(id) ON DELETE CASCADE,
    iterations INTEGER NOT NULL,
    probability DOUBLE PRECISION NOT NULL,
    
    -- Results (JSONB)
    histogram JSONB NOT NULL,
    sensitivity JSONB NOT NULL,
    
    -- Metadata
    trigger_reason VARCHAR(255),
    executed_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_simulations_forecast_id ON simulations(forecast_id);

-- Events (for event sourcing / time-travel)
CREATE TABLE forecast_events (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    forecast_id UUID NOT NULL REFERENCES forecasts(id) ON DELETE CASCADE,
    event_type VARCHAR(100) NOT NULL,
    event_data JSONB NOT NULL,
    user_id UUID REFERENCES users(id),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE INDEX idx_forecast_events_forecast_id ON forecast_events(forecast_id);
CREATE INDEX idx_forecast_events_created_at ON forecast_events(created_at);

-- Calibration tracking
CREATE TABLE user_calibration (
    user_id UUID PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
    total_forecasts INTEGER NOT NULL DEFAULT 0,
    resolved_forecasts INTEGER NOT NULL DEFAULT 0,
    avg_brier_score DOUBLE PRECISION,
    calibration_curve JSONB, -- Binned data
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
EOF

