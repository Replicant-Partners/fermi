│   ├── parser.rs        # Nom-based parser
│   ├── ast.rs           # Abstract syntax tree
│   └── typechecker.rs   # Semantic analysis
│
├── uffp-simulation/     # Monte Carlo engine
│   ├── distributions.rs # Probability distributions
│   ├── engine.rs        # Simulation loop
│   └── sensitivity.rs   # Variance decomposition
│
├── uffp-agents/         # Agent orchestration
│   ├── orchestrator.rs  # Agent lifecycle
│   ├── a2a.rs           # Agent-to-agent protocols
│   └── mcp.rs           # Model Context Protocol
│
├── uffp-crdt/           # Collaboration engine
│   ├── sync.rs          # Yrs integration
│   └── conflict.rs      # Conflict resolution
│
├── uffp-storage/        # Event store, queries
│   ├── event_store.rs   # Append-only log
│   └── projections.rs   # Read models
│
